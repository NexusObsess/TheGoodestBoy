  m_Script: {fileID: 11500000, guid: 2efde7e9e75a7e747817347127bcb875, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextTreeChooser
  PossibleSequencesMorale:
  - DialogueTree:
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: The people of the town are in high spirits! The streets are full of friendly
        smiling faces who give you many pets and treats.
    townMoraleThreshold: 90
    knightHealthThreshold: 0
  - DialogueTree:
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: The people of the town are slightly nervous. The streets seem less lively
        and when people approach you with pets and treats, they also ask after the
        knight's health.
    townMoraleThreshold: 60
    knightHealthThreshold: 0
  - DialogueTree:
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: 'The people of the town are very tense. Very few sorry looking townspeople
        are still out by the time you get back and they all walk in groups. The baker
        asks if the town should prepare for the worst. '
    townMoraleThreshold: 30
    knightHealthThreshold: 0
  - DialogueTree:
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: You don't see anyone on the way into town, aside from the woodworker
        fortifying the end of the town leading into the forest who doesn't look at
        you. The buildings are boarded up and you get no treats.
    townMoraleThreshold: 0
    knightHealthThreshold: 0
  PossibleSequencesKnightHealth:
  - DialogueTree:
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: The knight's condition is stable and even threw your ball a few times
        before you snuggled up and fell asleep.
    townMoraleThreshold: 0
    knightHealthThreshold: 6
  - DialogueTree:
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: Game over day 1
    townMoraleThreshold: 0
    knightHealthThreshold: 5
  - DialogueTree:
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: Game over day 2
    townMoraleThreshold: 0
    knightHealthThreshold: 4
  - DialogueTree:
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: Game over day 3
    townMoraleThreshold: 0
    knightHealthThreshold: 3
  - DialogueTree:
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: Game over day 4
    townMoraleThreshold: 0
    knightHealthThreshold: 2
  - DialogueTree:
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: Game over day 5
    townMoraleThreshold: 0
    knightHealthThreshold: 1
