--- !u!114 &2211131326396378409
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2290587939521897860}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2efde7e9e75a7e747817347127bcb875, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextTreeChooser
  PossibleSequencesMorale:
  - DialogueTree:
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: The wannabe hero sobs uncontrollably. He doesn't notice you at first.
      DogSoundEffect: {fileID: 0}
    - Speaker: {fileID: 4932804068736571853}
      TextSpeed: 1
      Line: H-huh?
      DogSoundEffect: {fileID: 8300000, guid: 8f4cf9fc92d8d474a832248a18048d6d, type: 3}
    - Speaker: {fileID: 4932804068736571853}
      TextSpeed: 3
      Line: Oh, hi doggy... sniff!
      DogSoundEffect: {fileID: 0}
    - Speaker: {fileID: 4932804068736571853}
      TextSpeed: 1
      Line: I know... I'm super 'orry, mummy says not to... go into the forest by
        myself...
      DogSoundEffect: {fileID: 8300000, guid: 8f4cf9fc92d8d474a832248a18048d6d, type: 3}
    - Speaker: {fileID: 4932804068736571853}
      TextSpeed: 1
      Line: I thought I could be cool... like you and the knight.
      DogSoundEffect: {fileID: 0}
    - Speaker: {fileID: 4932804068736571853}
      TextSpeed: 1
      Line: But I made wrouble for you and mummy.
      DogSoundEffect: {fileID: 8300000, guid: b0457ef8882733244885214b1de98c91, type: 3}
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: The wannabe hero takes a long shaking breath.
      DogSoundEffect: {fileID: 0}
    - Speaker: {fileID: 4932804068736571853}
      TextSpeed: 1
      Line: Can you... sniff! Help me home?
      DogSoundEffect: {fileID: 0}
    townMoraleThreshold: 0
    knightHealthThreshold: 0
    currentDayThreshold: 0
  PossibleSequencesKnightHealth: []
  PossibleSequencesCurrentDay: []
