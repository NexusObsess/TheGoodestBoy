--- !u!114 &6029366264072640790
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8210371082398829670}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2efde7e9e75a7e747817347127bcb875, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TextTreeChooser
  PossibleSequencesMorale:
  - DialogueTree:
    - Speaker: {fileID: 9099556265879683154}
      TextSpeed: 1
      Line: Woof, woof! (Look at what the cat dragged in! I was beginning to think
        you were too much of a coward to meet me face to face.)
      DogSoundEffect: {fileID: 0}
    - Speaker: {fileID: 9099556265879683154}
      TextSpeed: 1
      Line: Groooowwlll... (No more hiding behind stupid letters! Let's fight...
        pata e pata...)
      DogSoundEffect: {fileID: 0}
    - Speaker: {fileID: 9099556265879683154}
      TextSpeed: 2
      Line: Boof? Woof, woof! (You want to... talk? Oh, are you so scared of my awesomeness
        that you're going to plead for mercy? You really are a coward, I-)
      DogSoundEffect: {fileID: 8300000, guid: 8f4cf9fc92d8d474a832248a18048d6d, type: 3}
    - Speaker: {fileID: 9099556265879683154}
      TextSpeed: 2
      Line: Woof... woof, woof? (Huh? You thought... I was just playing around?)
      DogSoundEffect: {fileID: 8300000, guid: 8f4cf9fc92d8d474a832248a18048d6d, type: 3}
    - Speaker: {fileID: 9099556265879683154}
      TextSpeed: 2
      Line: Boof, boof... woof, woof... (But... you kept trying to find me? I bet
        you wanted to rub in how much of a good boy you were to my face... A way
        better boy than me...)
      DogSoundEffect: {fileID: 0}
    - Speaker: {fileID: 9099556265879683154}
      TextSpeed: 2
      Line: Boof... (Was... this really all in my head?)
      DogSoundEffect: {fileID: 0}
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: You really wanted to be friends, but the rival dog clearly has a lot
        going on. You aren't sure how to help... But maybe someone else can?
      DogSoundEffect: {fileID: 0}
    - Speaker: {fileID: 9099556265879683154}
      TextSpeed: 1
      Line: Woof? Woof, woof! (Counseling? What, you think I need some dumb human
        to tell me I'm a good boy to feel good about myself. Forget it, I-)
      DogSoundEffect: {fileID: 0}
    - Speaker: {fileID: 9099556265879683154}
      TextSpeed: 1
      Line: Boof... Woof, woof! (...I'll think about it. But... not because you told
        me too! Stupid mutt!)
      DogSoundEffect: {fileID: 0}
    - Speaker: {fileID: 0}
      TextSpeed: 1
      Line: The rival dog storms off. You... think that went well?
      DogSoundEffect: {fileID: 0}
    townMoraleThreshold: 0
    knightHealthThreshold: 0
    currentDayThreshold: 0
  PossibleSequencesKnightHealth: []
  PossibleSequencesCurrentDay: []
